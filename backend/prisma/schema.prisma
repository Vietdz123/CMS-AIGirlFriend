generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN // toàn quyền: quản lý user, kết nối tài khoản AdMob, xem mọi app
  MANAGER // xem các app được gán, được bấm Update (sync)
  VIEWER // chỉ xem các app được gán
}

enum SyncStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum SyncTrigger {
  INITIAL
  MANUAL
  SCHEDULED
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  name         String
  passwordHash String
  role         Role            @default(VIEWER)
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  appAccess    UserAppAccess[]
}

model UserAppAccess {
  userId String
  appId  String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  app    App    @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@id([userId, appId])
}

model AdmobAccount {
  id              String    @id @default(cuid())
  publisherId     String    @unique // pub-XXXXXXXXXXXXXXXX
  name            String
  currencyCode    String
  timeZone        String
  refreshTokenEnc String // refresh token Google đã mã hoá AES-256-GCM
  lastSyncedAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  apps            App[]
  adUnits         AdUnit[]
  syncRuns        SyncRun[]
}

model App {
  id          String          @id // ca-app-pub-XXX~YYY (AdMob app id, globally unique)
  accountId   String
  account     AdmobAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name        String
  platform    String // ANDROID | IOS
  storeId     String? // package name trên Google Play
  updatedAt   DateTime        @updatedAt
  adUnits     AdUnit[]
  userAccess  UserAppAccess[]

  @@index([accountId])
}

model AdUnit {
  id        String       @id // ca-app-pub-XXX/ZZZ
  accountId String
  account   AdmobAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  appId     String
  app       App          @relation(fields: [appId], references: [id], onDelete: Cascade)
  name      String
  format    String // BANNER | INTERSTITIAL | REWARDED | NATIVE | APP_OPEN | ...
  updatedAt DateTime     @updatedAt

  @@index([appId])
}

/// Mediation report KHÔNG chia theo ad source: 1 dòng = 1 ngày x 1 ad unit x 1 quốc gia.
/// Doanh thu/impression gồm mọi mạng (AdMob + mediation), request/match rate đúng ở cấp ad unit.
model UnitStat {
  id              BigInt   @id @default(autoincrement())
  accountId       String
  date            DateTime @db.Date
  appId           String
  adUnitId        String
  format          String
  country         String
  earningsMicros  BigInt
  impressions     BigInt
  clicks          BigInt
  adRequests      BigInt
  matchedRequests BigInt

  @@index([accountId, date])
  @@index([appId, date])
  @@index([date])
}

/// Mediation report chia theo ad source: 1 dòng = 1 ngày x 1 ad unit x 1 ad source (AdMob Network, Meta, AppLovin, ...).
/// Chỉ dùng cho breakdown theo mạng quảng cáo (request ở đây là request waterfall gửi tới từng source).
model SourceStat {
  id              BigInt   @id @default(autoincrement())
  accountId       String
  date            DateTime @db.Date
  appId           String
  adUnitId        String
  format          String
  adSourceId      String
  adSourceName    String
  earningsMicros  BigInt
  impressions     BigInt
  clicks          BigInt
  adRequests      BigInt
  matchedRequests BigInt

  @@index([accountId, date])
  @@index([appId, date])
  @@index([date])
}

model SyncRun {
  id         String       @id @default(cuid())
  accountId  String
  account    AdmobAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  trigger    SyncTrigger
  status     SyncStatus   @default(RUNNING)
  fromDate   String // YYYY-MM-DD
  toDate     String
  rowCount   Int          @default(0)
  error      String?
  startedAt  DateTime     @default(now())
  finishedAt DateTime?

  @@index([accountId, startedAt])
}

/// Tài khoản quảng cáo Facebook (Meta), token System User mã hoá AES-256-GCM.
model FbAdAccount {
  id           String       @id // act_XXXXXXXX
  name         String
  currencyCode String
  timeZone     String
  tokenEnc     String
  lastSyncedAt DateTime?
  lastError    String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  campaigns    FbCampaign[]
}

/// Chiến dịch Facebook. App được xác định theo storeId (package name) khớp với App.storeId,
/// hoặc gán tay bằng appId (ưu tiên hơn).
model FbCampaign {
  id        String      @id
  accountId String
  account   FbAdAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name      String
  storeId   String? // package name lấy từ promoted_object của chiến dịch / ad set
  appId     String? // gán tay, ghi đè storeId
  updatedAt DateTime    @updatedAt

  @@index([accountId])
}

/// Chi phí quảng cáo: 1 dòng = 1 ngày x 1 chiến dịch x 1 quốc gia (ngày theo múi giờ tài khoản quảng cáo).
/// source = "facebook": accountId/campaignId trỏ tới FbAdAccount/FbCampaign;
/// source = "google": trỏ tới GadsAccount/GadsCampaign.
model AdSpendStat {
  id          BigInt   @id @default(autoincrement())
  source      String   @default("facebook")
  accountId   String
  date        DateTime @db.Date
  campaignId  String
  country     String
  /// Chi phí đã quy đổi sang USD theo tỷ giá ngày đó (dùng cho mọi báo cáo).
  spendMicros BigInt
  /// Chi phí gốc theo tiền tệ của tài khoản quảng cáo.
  localSpendMicros BigInt @default(0)
  currency         String @default("USD")
  /// Conversion value do nền tảng quảng cáo báo (Google Ads: metrics.conversions_value), đã quy đổi USD.
  convValueMicros      BigInt @default(0)
  /// Conversion value theo tiền tệ gốc.
  localConvValueMicros BigInt @default(0)
  impressions BigInt
  clicks      BigInt
  installs    BigInt

  @@index([accountId, date])
  @@index([campaignId, date])
  @@index([date])
}

/// Tài khoản Google Ads (tài khoản quảng cáo, không phải MCC). Refresh token OAuth mã hoá AES-256-GCM.
model GadsAccount {
  id              String         @id // customer id 10 chữ số, không có dấu gạch
  loginCustomerId String // MCC dùng để truy cập, hoặc chính id nếu truy cập trực tiếp
  name            String
  currencyCode    String
  timeZone        String
  refreshTokenEnc String
  lastSyncedAt    DateTime?
  lastError       String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  campaigns       GadsCampaign[]
}

/// Chiến dịch Google Ads. Ghép app giống FbCampaign: storeId (package của App campaign) hoặc appId gán tay.
model GadsCampaign {
  id        String      @id
  accountId String
  account   GadsAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name      String
  storeId   String?
  appId     String?
  updatedAt DateTime    @updatedAt

  @@index([accountId])
}

/// Tỷ giá theo ngày: 1 USD = rate đơn vị currency. Lấy tự động, cache để không gọi lại.
model FxRate {
  date     DateTime @db.Date
  currency String
  rate     Float // số đơn vị tiền tệ cho 1 USD
  /// true = admin sửa tay trên trang Tỷ giá (đồng bộ không ghi đè).
  manual   Boolean  @default(false)

  @@id([date, currency])
}

/// Conversion value Google Ads theo độ trễ chuyển đổi, để tính ROAS D0/D3/D7/D14/D30.
/// 1 dòng = 1 ngày tương tác quảng cáo x 1 chiến dịch x 1 nhóm độ trễ (segments.conversion_lag_bucket).
model GadsConvLagStat {
  id               BigInt   @id @default(autoincrement())
  accountId        String
  date             DateTime @db.Date
  campaignId       String
  lagBucket        String // LESS_THAN_ONE_DAY, ONE_TO_TWO_DAYS, ... (tên enum của Google Ads)
  valueMicros      BigInt // USD
  localValueMicros BigInt // tiền tệ gốc của tài khoản

  @@index([accountId, date])
  @@index([campaignId, date])
}

/// Budget/ngày của chiến dịch Facebook / Google Ads theo ngày (mức cuối ngày, theo múi giờ tài khoản quảng cáo).
/// Ghi mỗi lần đồng bộ; các ngày trước được dựng lại từ lịch sử thay đổi budget (Google ~30 ngày, Facebook theo
/// nhật ký hoạt động). Không có dòng = không có budget/ngày (chưa tạo chiến dịch, hoặc dùng lifetime budget).
model CampaignBudgetDay {
  id                BigInt   @id @default(autoincrement())
  source            String // facebook | google
  accountId         String
  campaignId        String
  date              DateTime @db.Date
  budgetMicros      BigInt // USD
  localBudgetMicros BigInt // tiền tệ gốc của tài khoản
  currency          String

  @@unique([source, campaignId, date])
  @@index([accountId, date])
}

/// Retention từ GA4 (cohort theo ngày mở app lần đầu): 1 dòng = 1 ngày cài x 1 nước x 1 nguồn (firstUserSource).
/// active[n] = số người dùng của cohort còn hoạt động vào ngày thứ n (n = 0..60). Mảng chỉ chứa các ngày đã đủ
/// (ngày cài + n < hôm nay), nên độ dài mảng cho biết mốc nào đã có số.
model RetentionStat {
  id       BigInt   @id @default(autoincrement())
  date     DateTime @db.Date // ngày cài (múi giờ property GA4)
  country  String // ISO 3166-1, "ZZ" = không rõ
  source   String // firstUserSource của GA4, ví dụ apps.facebook.com, google-play, (direct)
  newUsers Int
  active   Int[]

  @@unique([date, country, source])
  @@index([date])
}

/// Phiên bản app người dùng dùng trong ngày cài (ngày 0 của cohort), để ước tính retention theo phiên bản cài.
/// GA4 không lưu phiên bản lúc cài; phiên bản ở ngày 0 gần đúng với phiên bản cài.
model RetentionInstallVersion {
  id         BigInt   @id @default(autoincrement())
  date       DateTime @db.Date
  country    String
  source     String
  appVersion String // "?" = GA4 không có phiên bản
  users      Int

  @@unique([date, country, source, appVersion])
  @@index([date])
}

/// Doanh thu quảng cáo (GA4 totalAdRevenue, USD) của 1 ngày chia theo ngày cài (firstSessionDate) của người dùng.
/// installDate null = GA4 không có ngày cài ("(not set)").
model RevenueCohortStat {
  id            BigInt    @id @default(autoincrement())
  date          DateTime  @db.Date // ngày phát sinh doanh thu
  installDate   DateTime? @db.Date
  revenueMicros BigInt
  users         Int

  @@index([date])
}

/// Lịch sử số liệu chi phí Google Ads của từng ngày: mỗi lần đồng bộ thấy tổng của ngày (theo tài khoản) khác lần ghi trước
/// thì thêm 1 dòng. Dùng để xem Google điều chỉnh chi phí, conversion value của ngày cũ thế nào.
model SpendSnapshot {
  id              BigInt   @id @default(autoincrement())
  source          String // google
  accountId       String
  date            DateTime @db.Date
  spendMicros     BigInt // USD
  convValueMicros BigInt // USD
  installs        BigInt
  capturedAt      DateTime @default(now())

  @@index([source, accountId, date, capturedAt])
  @@index([date])
}

/// Số dư tài khoản Google Ads (account budget) ghi mỗi ngày khi có thay đổi: hạn mức đã nạp, đã tiêu, tổng điều chỉnh
/// (tín dụng Google cộng / trừ vào tài khoản). Tiền gốc của tài khoản (micros).
model GadsBalanceSnapshot {
  id               BigInt   @id @default(autoincrement())
  accountId        String
  currency         String
  limitMicros      BigInt // approved_spending_limit: tổng đã nạp / hạn mức
  servedMicros     BigInt // amount_served: đã tiêu
  adjustmentMicros BigInt // total_adjustments: tổng điều chỉnh (tín dụng)
  capturedAt       DateTime @default(now())

  @@index([accountId, capturedAt])
}

/// Doanh thu mua trong app (Google Play, báo cáo bán hàng ước tính trên Cloud Storage) đã cộng theo ngày tính tiền x
/// sản phẩm x nước. Không lưu mã đơn hay thông tin người mua. Tiền gốc là tiền tệ người mua trả.
model IapSaleStat {
  id               BigInt   @id @default(autoincrement())
  date             DateTime @db.Date // ngày tính tiền (Order Charged Date)
  packageName      String
  sku              String // mã sản phẩm / gói (coin_pack_9.99, waifu_monthly_plan…)
  productType      String // inapp | subscription | …
  country          String
  currency         String
  orders           Int // số đơn đã tính tiền
  refunds          Int // số đơn hoàn tiền
  /// Tiền hàng chưa thuế, đã trừ hoàn tiền.
  priceLocalMicros BigInt
  taxLocalMicros   BigInt
  priceUsdMicros   BigInt
  taxUsdMicros     BigInt

  @@index([date])
  @@index([packageName, date])
}

/// Doanh thu quảng cáo GA4 (totalAdRevenue, USD) của người dùng đến từ 1 chiến dịch (firstUserCampaign, nguồn google),
/// theo ngày cài x số ngày sau khi cài (dayN = ngày phát sinh - ngày cài). Dùng cho ROAS DN theo GA4, không bị giới
/// hạn bởi cửa sổ chuyển đổi 7 ngày của Google Ads.
model GaCampaignRevenue {
  id            BigInt   @id @default(autoincrement())
  installDate   DateTime @db.Date
  campaignId    String // firstUserCampaignId của GA4 ("(not set)" nếu không có)
  campaignName  String
  dayN          Int
  revenueMicros BigInt
  users         Int // người dùng mới của chiến dịch trong ngày cài (chỉ ghi ở dòng dayN = 0)

  @@index([installDate])
}
