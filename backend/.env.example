PORT=3000
DATABASE_URL="postgresql://admob:admob@localhost:5432/admob_cms?schema=public"

# Chuỗi ngẫu nhiên dài, ví dụ: openssl rand -hex 32
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
# Dùng để mã hoá refresh token Google trong DB. KHÔNG đổi sau khi đã kết nối tài khoản.
ENCRYPTION_KEY=change-me-too

FRONTEND_URL=http://localhost:5173

# Lấy từ Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/admob/oauth/callback

# Mọi tài khoản AdMob được quy đổi về cùng 1 loại tiền khi lấy report
REPORT_CURRENCY=USD
# Số ngày dữ liệu lấy về lần đầu khi kết nối tài khoản
BACKFILL_DAYS=90

# Tài khoản admin được tạo bởi `npm run seed`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin123

# Google Ads API (chi phí UAC). Không cần developer token: quyền Explorer/Basic cấp theo project Google Cloud.
GOOGLE_ADS_API_VERSION=v25
