# Copy thành .env.production trên VPS và điền giá trị thật. KHÔNG commit file này.

# Tên miền đã trỏ A record về IP của VPS
DOMAIN=cms.example.com

# Tạo bằng: openssl rand -hex 24
POSTGRES_PASSWORD=

# Tạo bằng: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Tạo bằng: openssl rand -hex 32. KHÔNG đổi sau khi đã kết nối tài khoản AdMob.
ENCRYPTION_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

REPORT_CURRENCY=USD
BACKFILL_DAYS=90

# Tài khoản admin đầu tiên. Dùng mật khẩu mạnh vì web public ra internet.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Google Ads API (chi phí UAC)
GOOGLE_ADS_API_VERSION=v25
